{
  "name": "git-lazy-commit",
  "version": "1.0.0",
  "description": "Git Lazy Commit — 用 AI 分析 Git 变更，自动生成规范的 commit message",
  "main": "dist/index.js",
  "bin": {
    "git-lzc": "bin/lzc.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README_EN.md",
    ".lzc.example.json5"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm test && npm run clean && npm run build",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "keywords": [
    "git",
    "commit",
    "ai",
    "cli",
    "lazy",
    "conventional-commits"
  ],
  "author": "loonglee <leelong2020@outlook.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/leelong2020/git_lzc.git"
  },
  "dependencies": {
    "@types/json5": "^0.0.30",
    "axios": "^1.6.7",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "inquirer": "^8.2.6",
    "json5": "^2.2.3",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "packageManager": "pnpm@10.27.0+sha512.72d699da16b1179c14ba9e64dc71c9a40988cbdc65c264cb0e489db7de917f20dcf4d64d8723625f2969ba52d4b7e2a1170682d9ac2a5dcaeaab732b7e16f04a",
  "directories": {
    "test": "tests"
  },
  "type": "commonjs",
  "types": "./dist/index.d.ts",
  "bugs": {
    "url": "https://github.com/leelong2020/git_lzc/issues"
  },
  "homepage": "https://github.com/leelong2020/git_lzc#readme"
}
