{
  // API 提供商: ollama, openai, anthropic, gemini 等
  "apiProvider": "ollama",

  // 模型名称
  // ollama: gemma3:latest, qwen2.5-coder, llama3 等
  // openai: gpt-4, gpt-4-turbo, gpt-3.5-turbo 等
  // anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku 等
  "model": "gemma3:latest",

  // 界面语言: zh (中文), en (英文)
  "language": "zh",

  // 是否自动提交 commit: true 或 false
  "autoCommit": false,

  // commit 提交风格: conventional, simple, detailed
  "commitStyle": "conventional",

  // diff 预处理配置（可选）
  // diff 内容总字符预算，超出后按文件粒度截断，0 表示不限制
  // 默认：ollama 6000，其他 provider 12000（本地小模型建议 4000-8000）
  // "maxDiffChars": 6000,

  // diff 噪音文件排除模式（锁文件/构建产物等），支持 * 与 ** glob
  // "diffExcludePatterns": ["package-lock.json", "pnpm-lock.yaml", "dist/**"],

  // Ollama 上下文窗口大小（num_ctx），本地小模型建议 8192
  // "numCtx": 8192,

  // Ollama 思考模式（think），默认 false
  // 思考型模型（qwen3、gemma4 等）开启后可能耗尽输出预算导致无结果
  // "think": false,

  // API 基础 URL (ollama 默认: http://127.0.0.1:11434)
  "baseUrl": "http://127.0.0.1:11434",

  // API 密钥 (使用第三方 API 时需要)
  // "apiKey": "your-api-key-here"
}
